                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum(rate(pdns_auth_servfail_packets{job=\"scrapeConfig/monitoring/pdns-auth-external\"}[$__rate_interval]))",
                        "legendFormat": "SERVFAIL"
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "$datasource"
                      },
                      "spec": {
                        "expr": "sum(rate(pdns_auth_refused_packets{job=\"scrapeConfig/monitoring/pdns-auth-external\"}[$__rate_interval]))",
                        "legendFormat": "REFUSED"
